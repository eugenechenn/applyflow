{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "applyflow",
	"main": "cloudflare/worker-entry.js",
	"compatibility_date": "2026-04-15",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"workers_dev": true,
	"preview_urls": false,
	"keep_vars": true,
	"assets": {
		"directory": "./public",
		"binding": "ASSETS",
		"run_worker_first": true
	},
	"routes": [
		{
			"pattern": "www.apply-flow-use.com",
			"custom_domain": true
		},
		{
			"pattern": "apply-flow-use.com",
			"custom_domain": true
		},
		{
			"pattern": "app.apply-flow-use.com",
			"custom_domain": true
		}
	],
	"d1_databases": [
		{
			"binding": "APPLYFLOW_DB",
			"database_name": "applyflow",
			"database_id": "6b1e6220-aaa8-41c5-bdeb-a86e4f37719f"
		}
	],
	"vars": {
		"APPLYFLOW_RUNTIME": "cloudflare",
		"APPLYFLOW_DB_PROVIDER": "d1",
		"CLOUDFLARE_D1_BINDING": "APPLYFLOW_DB",
		"LLM_PROVIDER": "openai-compatible",
		"LLM_BASE_URL": "https://open.bigmodel.cn/api/paas/v4/",
		"LLM_MODEL": "glm-4.5-air",
		"SESSION_COOKIE_NAME": "applyflow_session",
		"SESSION_COOKIE_SAMESITE": "Lax",
		"SESSION_COOKIE_SECURE": "true",
		"AUTH_PROVIDER": "internal_beta",
		"INTERNAL_BETA_ENABLED": "true",
		"BETA_ALLOWED_EMAILS": "eugenec7012@126.com",
		"DEMO_MODE_ENABLED": "false",
		"DEMO_AUTO_LOGIN_ENABLED": "false",
		"DEV_AUTH_BYPASS_ENABLED": "false",
		"RESUME_PARSER_URL": "https://resume-parser-production-5580.up.railway.app/parse-resume"
	},
	"observability": {
		"logs": {
			"enabled": true
		}
	},
	"env": {
		"staging": {
			"name": "applyflow-staging",
			"vars": {
				"APPLYFLOW_RUNTIME": "cloudflare",
				"APPLYFLOW_DB_PROVIDER": "d1",
				"CLOUDFLARE_D1_BINDING": "APPLYFLOW_DB",
				"LLM_PROVIDER": "openai-compatible",
				"LLM_BASE_URL": "https://open.bigmodel.cn/api/paas/v4/",
				"LLM_MODEL": "glm-4.5-air",
				"SESSION_COOKIE_NAME": "applyflow_session",
				"SESSION_COOKIE_SAMESITE": "Lax",
				"SESSION_COOKIE_SECURE": "true",
				"RESUME_PARSER_URL": "https://resume-parser-production-5580.up.railway.app/parse-resume",
				"AUTH_PROVIDER": "internal_beta",
				"INTERNAL_BETA_ENABLED": "true",
				"DEMO_MODE_ENABLED": "true",
				"DEMO_USER_ID": "demo_user",
				"DEMO_AUTO_LOGIN_ENABLED": "false",
				"DEV_AUTH_BYPASS_ENABLED": "false"
			},
			"d1_databases": [
				{
					"binding": "APPLYFLOW_DB",
					"database_name": "applyflow-staging",
					"database_id": "ed3ef70f-7ca8-4f95-9858-f5ea825d7188"
				}
			]
		}
	}
}
