<?xml version="1.0" encoding="UTF-8"?>
<opml version="2.0">
  <head>
    <title>AI岗位面试复习地图</title>
  </head>
  <body>
    <outline text="AI岗位面试复习地图"><outline text="三个主场"><outline text="ApplyFlow：求职执行闭环"><outline text="岗位浏览→投递清单→状态回填→反馈复盘"/><outline text="可解释排序：userPriorityScore / Grade / Verdict"/><outline text="回答项目、Agent、评估、数据迭代"/></outline><outline text="网易AIGC实习：内容安全治理"><outline text="风险分类：事实性、版权、敏感、低质、诱导"/><outline text="Bad Case台账：输入/输出/风险/归因/复测"/><outline text="回答AIGC vs 人工内容、Prompt边界、人工复核"/></outline><outline text="Codex开发流程：AI Coding治理"><outline text="AGENTS.md：规则和边界"/><outline text="CONTEXT.md / TIMELINE.md：现场和留痕"/><outline text="Focused Review / 验证脚本：回归和安全门禁"/></outline></outline><outline text="1 业务场景题"><outline text="常见问法"><outline text="为什么做这个项目？"/><outline text="解决了什么真实问题？"/><outline text="AI产品怎么找场景？"/><outline text="AI招聘助手/客服/研报助手怎么设计？"/></outline><outline text="接回ApplyFlow"><outline text="真实任务：不是生成一句话，而是连续求职流程"/><outline text="AI价值：岗位和用户偏好之间的语义判断"/><outline text="系统价值：状态管理和反馈复盘"/></outline><outline text="口播" _note="我会先判断这个场景是不是值得用AI。ApplyFlow里值得用AI的点不是点击投递，而是岗位和用户偏好之间存在大量语义判断。"/></outline><outline text="2 Agent架构题"><outline text="常见问法"><outline text="Agent和workflow有什么区别？"/><outline text="为什么不用普通规则？"/><outline text="ReAct / Plan-and-Execute怎么选？"/><outline text="多Agent和单Agent+多工具怎么选？"/></outline><outline text="接回ApplyFlow"><outline text="workflow：岗位导入、排序、投递清单、状态回填"/><outline text="Agent能力：理解JD、生成解释、识别风险、下一步建议"/><outline text="Memory：用户偏好、岗位状态、反馈记录分开存"/></outline><outline text="口播" _note="ApplyFlow不是让模型自由行动，而是把Agent放进workflow里。模型做语义判断，系统决定状态能不能推进。"/></outline><outline text="3 系统边界题"><outline text="常见问法"><outline text="AI生成错了怎么办？"/><outline text="Prompt注入怎么办？"/><outline text="工具调用参数乱传怎么办？"/><outline text="用户数据怎么隔离？"/><outline text="为什么不做全自动投递？"/></outline><outline text="接回ApplyFlow/网易"><outline text="Prompt是软约束，Schema和权限是硬约束"/><outline text="外部投递不自动提交，用户最终确认"/><outline text="demo、真实池、白名单用户分层隔离"/><outline text="网易实习：生成结果要有风险分类和人工复核"/></outline><outline text="口播" _note="我不会把高风险动作交给模型直接执行。AI可以建议岗位，但加入投递清单、状态回填和真实投递都要有系统边界和用户确认。"/></outline><outline text="4 评估指标题"><outline text="常见问法"><outline text="你怎么评估Agent效果？"/><outline text="eval harness怎么搭？"/><outline text="benchmark怎么设计？"/><outline text="pass@k是什么？"/><outline text="模型升级后怎么防回退？"/></outline><outline text="ApplyFlow评估框架"><outline text="Task：固定用户画像和岗位池"/><outline text="Transcript：排序、解释、投递清单、状态回填、反馈"/><outline text="Outcome：是否进入投递清单，状态是否回填"/><outline text="Grader：代码脚本 + LLM/人工抽检 + 用户反馈"/></outline><outline text="口播" _note="评估不是看模型最后说得好不好，而是看任务有没有完成、轨迹是否可信、结果是否进了真实系统状态。"/></outline><outline text="5 数据迭代题"><outline text="常见问法"><outline text="你有用户数据吗？"/><outline text="指标提升从哪里来？"/><outline text="用户反馈怎么转成迭代？"/><outline text="Bad Case怎么治理？"/><outline text="A/B怎么做？"/></outline><outline text="接回Evidence Log"><outline text="来源：dogfooding + 朋友试用 + 固定测试画像"/><outline text="反馈：点击投递链接后内容混乱"/><outline text="迭代：打开链接、加入投递清单、标记已投递、反馈误判"/><outline text="指标：投递清单候选率 8.8%→16.7%"/><outline text="指标：状态回填率 33.3%→58.8%"/></outline><outline text="边界" _note="这是小样本同口径复测，不是大规模线上增长。"/></outline><outline text="6 工程落地题"><outline text="常见问法"><outline text="用Codex开发遇到什么难点？"/><outline text="怎么防止AI误改代码？"/><outline text="怎么做回归验证？"/><outline text="怎么处理缓存、状态错位、线上问题？"/></outline><outline text="接回开发治理"><outline text="AGENTS.md：读取顺序、不可改边界、验证规则"/><outline text="CONTEXT.md：保持当前工作现场"/><outline text="TIMELINE.md：记录阶段变化"/><outline text="Focused Review：正确性和安全边界"/><outline text="验证脚本：production smoke、UI smoke、排序gate"/></outline><outline text="口播" _note="我的项目不是只用Codex写代码，而是把Codex当成一个需要治理的Agent，给它上下文、规则、验证和复盘。"/></outline><outline text="7 知识盲区题"><outline text="常见问法"><outline text="RAG怎么做召回和rerank？"/><outline text="SFT / RLHF / Agentic RL怎么看？"/><outline text="多模态Agent怎么评估？"/><outline text="MCP / LangGraph / AutoGen怎么看？"/></outline><outline text="回答公式"><outline text="承认边界：我没有完整生产落地"/><outline text="讲理解：它核心解决什么问题"/><outline text="接项目：ApplyFlow里相近的问题是什么"/><outline text="讲下一步：先从数据/指标/边界开始验证"/></outline><outline text="RAG例子" _note="ApplyFlow当前不是RAG。如果未来接入公司信息、面经、政策或用户历史申请记录，我会把它设计成检索增强模块，重点评估召回覆盖、引用准确、幻觉和是否污染主排序。"/></outline><outline text="跨类联系：题目之间怎么串"><outline text="业务场景 → Agent架构"><outline text="先证明真实任务存在，再说明为什么需要Agent"/><outline text="例：求职不是单次问答，而是持续执行流程"/></outline><outline text="Agent架构 → 系统边界"><outline text="只要Agent能调用工具，就必须讲权限、Schema和人工确认"/><outline text="例：模型推荐岗位，但系统决定能否写状态"/></outline><outline text="系统边界 → 评估指标"><outline text="边界不是口头承诺，要用脚本和Bad Case复测"/><outline text="例：forged userId拒绝、投递状态回填验证"/></outline><outline text="评估指标 → 数据迭代"><outline text="评估发现问题后，要进入Evidence Log和迭代记录"/><outline text="例：投递清单候选率、状态回填率改版前后对比"/></outline><outline text="数据迭代 → 工程落地"><outline text="用户反馈不能只改文案，还要改状态流、缓存和验证"/><outline text="例：投递主路径收敛、localStorage残留修复"/></outline><outline text="工程落地 → 知识盲区"><outline text="没做过的技术也能回答落地思路：先数据、边界、评估"/><outline text="例：RAG/SFT/RL先不硬装，讲未来怎么接入ApplyFlow"/></outline><outline text="万能串法" _note="真实场景决定Agent是否必要；Agent一旦进入流程就必须有系统边界；边界要靠评估验证；评估发现问题进入数据迭代；迭代最终落到工程治理。"/></outline><outline text="90分钟复习路线"><outline text="10分钟：背7类题型和3个锚点"/><outline text="20分钟：背ApplyFlow 30秒、3分钟、五个深挖问题"/><outline text="15分钟：背Task/Transcript/Outcome/Grader"/><outline text="15分钟：背系统边界和Coding难点"/><outline text="15分钟：背网易实习30秒、AIGC vs 人工内容、Bad Case"/><outline text="15分钟：练5道知识盲区题"/></outline><outline text="最小背诵卡"><outline text="先从真实任务出发，不先堆技术名词"/><outline text="AI能力和确定性系统分开"/><outline text="Prompt是软约束，Schema/校验/日志/人工确认是硬治理"/><outline text="评估看任务结果、执行轨迹和真实系统状态"/><outline text="小样本同口径复测，不冒充大规模线上数据"/><outline text="不会的技术不硬装，说明理解、项目映射和下一步"/></outline></outline>
  </body>
</opml>
